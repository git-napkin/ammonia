#!/bin/sh
set -eu

SUPPORT="/private/var/ammonia/core"
PLIST="/Library/LaunchDaemons/com.ammonia.inject.plist"
OPTS="$SUPPORT/current.options"

mkdir -p /var/log/ammonia
mkdir -p "$SUPPORT/tweaks" "$SUPPORT/gui"
chmod 755 "$SUPPORT/tweaks" "$SUPPORT/gui" 2>/dev/null || true

if [ ! -f "$SUPPORT/ammonia.blacklist" ] && [ -f "$SUPPORT/share/ammonia.blacklist" ]; then
    cp "$SUPPORT/share/ammonia.blacklist" "$SUPPORT/ammonia.blacklist" || true
fi

if [ ! -f "$OPTS" ]; then
    cat > "$OPTS" <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>disablePAC</key>
	<false/>
	<key>pauseInjection</key>
	<false/>
	<key>enabledTweaks</key>
	<array/>
</dict>
</plist>
EOF
fi
chmod 666 "$OPTS" 2>/dev/null || true

defaults write /Library/Preferences/com.apple.security.libraryvalidation \
    DisableLibraryValidation -bool true

# Playground leftovers — do not migrate /opt; make install puts tweaks in place.
launchctl bootout system/com.pluginplayground.grant 2>/dev/null || true
rm -f /Library/LaunchDaemons/com.pluginplayground.grant.plist
rm -rf /opt/pluginplayground
rm -rf "/Applications/Plugin Playground.app"
rm -rf /var/log/pluginplayground
pkgutil --forget "com.pluginplayground.core" > /dev/null 2>&1 || true

if [ -f "$PLIST" ]; then
    chown root:wheel "$PLIST"
    chmod 644 "$PLIST"
    launchctl bootout system/com.ammonia.inject 2>/dev/null || true
    if ! launchctl bootstrap system "$PLIST"; then
        launchctl load "$PLIST"
    fi
fi

exit 0
